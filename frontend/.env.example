# Solana execution is Devnet only, including production builds.
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Leave blank for API-backed demo mode. Set only after an actual Devnet deployment.
VITE_SOLANA_PROGRAM_ID=
# Only Devnet is accepted; genesis hash is checked before wallet operations.
# Generated by anchor build then npm run anchor:idl
VITE_ANCHOR_IDL_URL=/idl/gobuy_na.json
# Account login: public Firebase Web app configuration (never service-account credentials).
VITE_FIREBASE_API_KEY= AIzaSyAGfNSju4ri_dMrdaRSIhoGYacLRd-oJmI
VITE_FIREBASE_AUTH_DOMAIN= gobuy-dd42a.firebaseapp.com
VITE_FIREBASE_PROJECT_ID= gobuy-dd42a
VITE_FIREBASE_APP_ID= 1:1075748734317:web:735d47aba1cfef5d9f0664
# Local testing only; requires a demo- project ID and an Auth emulator.
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# Optional localhost development with fictional numbers saved in Firebase Console.
# Disables app verification for testing; real phone numbers will not work in this mode.
# Ignored in production builds and on non-loopback hosts.
# VITE_FIREBASE_PHONE_TEST_MODE=true

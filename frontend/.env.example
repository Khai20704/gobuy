# Leave blank for API-backed demo mode. Set only after an actual Devnet deployment.
VITE_SOLANA_PROGRAM_ID=
# Only Devnet is accepted; genesis hash is checked before wallet operations.
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
# Generated by anchor build then npm run anchor:idl
VITE_ANCHOR_IDL_URL=/idl/gobuy_na.json

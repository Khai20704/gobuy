# Solana execution is Devnet only, including production builds.
SOLANA_NETWORK=devnet
NFT_DISCOVERY_MODE=marketplace
DISCOVERY_NETWORK=devnet
SOLANA_EXECUTION_NETWORK=devnet
ENABLE_MAINNET_EXECUTION=false
NFT_PROVIDER_TIMEOUT_MS=30000
# Acquisition score weights must sum to 1; absent signals reduce confidence.
NFT_SCORE_WEIGHT_INTENT=0.3
NFT_SCORE_WEIGHT_PREFERENCE=0.2
NFT_SCORE_WEIGHT_VISUAL=0.15
NFT_SCORE_WEIGHT_RARITY=0.1
NFT_SCORE_WEIGHT_MARKET=0.15
NFT_SCORE_WEIGHT_PRICE=0.1
NFT_MIN_ACQUISITION_SCORE=55
NFT_MIN_ACQUISITION_CONFIDENCE=30
SOLANA_RPC_URL=https://api.devnet.solana.com
# Copy frontend/.env.example to frontend/.env.local.
# Copy backend/.env.example to backend/.env (optional).
# Vite also reads root .env; backend scripts load backend/.env. Keep Solana settings aligned.
# Research settings belong ONLY in backend/.env (see backend/.env.example):
# SEARCH_PROVIDER_MODE=auto|real|mock
# BRAVE_SEARCH_API_KEY=...
# EBAY_ACCESS_TOKEN=... (official Browse API application token)
# EBAY_MARKETPLACE_ID=EBAY_US
# LLM_PROVIDER_ORDER=openai,anthropic,gemini,groq,ollama
# OPENAI_API_KEY=... (optional; one of five supported LLM providers)
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_API_KEY=...
# GROQ_MODEL=llama-3.3-70b-versatile
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=... (optional local model already installed)
# OLLAMA_CONTEXT_WINDOW_TOKENS=8192
# OPENAI_SEARCH_MODEL=gpt-5.5
# OPENAI_SEARCH_TIMEOUT_MS=45000
# COINGECKO_API_KEY=... (optional; live SOL/fiat rates)
# SEARCH_TIMEOUT_MS=8000
# LLM_REQUEST_TIMEOUT_MS=30000
# LLM_TOTAL_TIMEOUT_MS=120000
# LLM_FAILURE_THRESHOLD=3
# LLM_COOLDOWN_SECONDS=60
# SEARCH_FAILURE_THRESHOLD=3
# SEARCH_COOLDOWN_SECONDS=60
# TWIN_DATA_DIR=.data/commerce-twins
# APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# RANKING_WEIGHTS_JSON={"productMatch":25,"budgetMatch":20,"sellerTrust":20,"productEvidence":15,"websiteTrust":10,"preferenceMatch":10}
# No user private keys or seed phrases. Never expose research secrets through VITE_ variables.

# Server-only optional Anthropic fallback:
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# Optional deployment-owned HTTPS Ondo normalized data feed; see docs/NA_ARCHITECTURE_V2.md.
# ONDO_DATA_URL=

# Extension build settings are public origins, never API keys. Set in the build shell:
# GOBUY_API_ORIGIN=http://localhost:3001
# GOBUY_WEB_ORIGIN=http://localhost:5173
# Helius credentials and NFT acquisition settings belong only in backend/.env.

# Na Vault: new deployed mandate program; Devnet only. Never use the Phantom owner secret.
NA_PROGRAM_ID=CHjdqooB7TrussJoZoboFP5TtdCspoHtvPpqoshbr5zE
# Dedicated server-side Devnet agent keypair JSON (64 bytes) or base58. Keep outside source control.
NA_AGENT_KEYPAIR=
# Optional pinned Devnet settlement recipient public key.
NA_SETTLEMENT_ADDRESS=
# Genuine NFT purchase (Na Vault -> Tensor -> owner wallet). See docs/GENUINE_NFT_PURCHASE.md.
# Off by default: with it off, discovery/quotes/authorization read all work but nothing is broadcast.
NFT_PURCHASE_LIVE_ENABLED=false
# Legacy DEMO autonomous NFT flow. Off by default; new orders must use the genuine purchase path.
# Orders already persisted still reconcile while this stays off.
GOBUY_DEMO_AUTOPURCHASE_ENABLED=false
# RWA: server-only Jupiter key; Mongo collection RWA_APPROVED_LIST stores approved identities.
JUPITER_API_KEY=
RWA_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# APP_STORAGE=file only; JSON array, relative to backend working directory.
RWA_APPROVED_LIST_PATH=

{
  "name": "@gobuy/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "tsc -p ../shared/tsconfig.json && npm run build -w @gobuy/tensor-adapter",
    "prebuild": "npm run build -w @gobuy/tensor-adapter",
    "dev": "tsx watch --exclude \"../shared/dist/**\" --exclude \"tests/**\" --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "prelint": "npm run build -w @gobuy/tensor-adapter",
    "lint": "tsc --noEmit",
    "check:mongo": "node --env-file-if-exists=.env --import tsx src/scripts/checkMongo.ts",
    "migrate:accounts:mongo": "node --env-file-if-exists=.env --import tsx src/scripts/migrateMongo.ts"
  },
  "dependencies": {
    "@gobuy/shared": "0.1.0",
    "@metaplex-foundation/mpl-core": "^1.10.0",
    "@metaplex-foundation/umi": "^1.6.0",
    "@metaplex-foundation/umi-bundle-defaults": "^1.6.0",
    "@metaplex-foundation/umi-web3js-adapters": "^1.6.0",
    "@solana/web3.js": "^1.99.0",
    "@gobuy/tensor-adapter": "0.1.0",
    "express": "^5.2.1",
    "firebase-admin": "^14.5.0",
    "mongodb": "^7.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0"
  }
}

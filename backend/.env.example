# Solana execution is Devnet only, including production builds.
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Backend-only dedicated Devnet endpoint recommended. Never copy its credentials into VITE_*.
SOLANA_RPC_MAX_CONCURRENT=3
SOLANA_RPC_BALANCE_CACHE_TTL_MS=20000
# Public HTTPS backend origin serving /api/acquisition/delivery-metadata/:id.
# Required for newly minted demo NFTs; existing NFT transfers keep their original metadata.
NFT_DEMO_PUBLIC_URL=
# New Core orders require a durable public HTTPS demo image (PNG recommended).
# Quick Tunnel/ngrok URLs are rejected; both URLs are frozen before payment.
NFT_DEMO_IMAGE_URL=
# Enable only after explicit approval for live Devnet delivery. Default is disabled.
DEVNET_DELIVERY_LIVE_ENABLED=false
# Genuine NFT purchase: Na Vault pays Tensor and the original NFT goes to the owner's wallet.
# See docs/GENUINE_NFT_PURCHASE.md. Default disabled; discovery and authorization reads still work.
NFT_PURCHASE_LIVE_ENABLED=false
# Legacy DEMO autonomous NFT flow. Off by default; new orders must use the genuine purchase path.
# Orders already persisted still reconcile while this stays off.
GOBUY_DEMO_AUTOPURCHASE_ENABLED=false
# Asset acquisition: mainnet discovery is read-only; execution is always a simulation.
NFT_DISCOVERY_MODE=marketplace
DISCOVERY_NETWORK=devnet
SOLANA_EXECUTION_NETWORK=devnet
ENABLE_MAINNET_EXECUTION=false
NFT_PROVIDER_TIMEOUT_MS=30000
NFT_SCORE_WEIGHT_INTENT=0.3
NFT_SCORE_WEIGHT_PREFERENCE=0.2
NFT_SCORE_WEIGHT_VISUAL=0.15
NFT_SCORE_WEIGHT_RARITY=0.1
NFT_SCORE_WEIGHT_MARKET=0.15
NFT_SCORE_WEIGHT_PRICE=0.1
NFT_MIN_ACQUISITION_SCORE=55
NFT_MIN_ACQUISITION_CONFIDENCE=30
NFT_MIN_AUTO_BUY_SCORE=65
NFT_MIN_AUTO_BUY_CONFIDENCE=55
NFT_MAX_AUTO_BUY_RISK=45
# Optional for APP_STORAGE=file only; single backend process during local development.
ASSET_DATA_DIR=.data/assets
HOST=127.0.0.1
PORT=3001
# All values below stay on the server. Never use VITE_ for these secrets.
# auto: compatibility alias for real; missing keys never enable fixtures.
# real: never fall back to mock, including during provider failures.
# mock: synthetic development fixtures only.
SEARCH_PROVIDER_MODE=real
SERPAPI_KEY=
# Official eBay Browse API production OAuth application token; refresh when expired.
EBAY_ACCESS_TOKEN=
EBAY_MARKETPLACE_ID=EBAY_US
# Read-only Magic Eden lookups accept a collection name or exact symbol. API key is optional for these public read endpoints.
# AI and search are separate. LLMs are optional; structured search works with live search sources alone.
LLM_PROVIDER_ORDER=openai,anthropic,gemini,groq,ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI search adapter; SerpApi/eBay/Magic Eden work independently.
OPENAI_SEARCH_MODEL=gpt-5.5
OPENAI_SEARCH_TIMEOUT_MS=45000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Local fallback is enabled only when OLLAMA_MODEL is set and installed.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
# Set truthful context limits when overriding models; unknown limits are not assumed larger.
# OPENAI_CONTEXT_WINDOW_TOKENS=128000
# GEMINI_CONTEXT_WINDOW_TOKENS=1048576
# GROQ_CONTEXT_WINDOW_TOKENS=131072
OLLAMA_CONTEXT_WINDOW_TOKENS=8192
LLM_REQUEST_TIMEOUT_MS=30000
LLM_TOTAL_TIMEOUT_MS=120000
LLM_FAILURE_THRESHOLD=3
LLM_COOLDOWN_SECONDS=60
# Optional CoinGecko Demo key; rates must include a fresh source timestamp.
COINGECKO_API_KEY=
SEARCH_TIMEOUT_MS=8000
# Legacy LLM_TIMEOUT_MS remains accepted when LLM_REQUEST_TIMEOUT_MS is absent.
SEARCH_FAILURE_THRESHOLD=3
SEARCH_COOLDOWN_SECONDS=60
# Relative to backend/ with npm workspace scripts. Never serve this directory publicly.
TWIN_DATA_DIR=.data/commerce-twins
# Exact browser origins allowed through your reverse proxy. Comma-separated, no trailing slash.
# The deployed frontend origin must be listed too, e.g. the production build served by Vercel:
# APP_ORIGINS=https://gobuy-frontend-plum.vercel.app
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional JSON weights, normalized after preference adjustments; positive sum required.
RANKING_WEIGHTS_JSON={"productMatch":25,"budgetMatch":20,"sellerTrust":20,"productEvidence":15,"websiteTrust":10,"preferenceMatch":10}
# The Na Agent keypair below is the ONLY signing key the backend holds: it is the fee payer and
# authorized executor for genuine purchases. It never holds the owner's keys, seed phrase or mandate.
# The Vault PDA, not the agent, is the account that pays a marketplace.

# Server-only optional Anthropic fallback:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Optional deployment-owned HTTPS Ondo normalized data feed; see docs/NA_ARCHITECTURE_V2.md.
ONDO_DATA_URL=
# RWA identity checks and Jupiter mainnet quotes. See docs/RWA_APPROVED_LIST.md.
# Server-only key. Never commit a real value here; leave blank in the example.
JUPITER_API_KEY=
RWA_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Mongo uses the RWA_APPROVED_LIST collection. JSON override is file-storage only.
RWA_APPROVED_LIST_PATH=
# Accounts: use the same project as the frontend. Admin credentials stay server-side.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Private application persistence. Mongo is the default; file is development/tests only.
APP_STORAGE=mongo
# Server-only. Never commit a real value here; leave blank in the example.
MONGODB_URI=
MONGODB_DB_NAME=gobuy
# A mongodb+srv:// URI needs an SRV DNS lookup. Resolvers that intercept port 53 often answer SRV
# queries with a malformed packet (EBADRESP), so the backend retries that lookup over DNS-over-HTTPS
# and rebuilds a direct mongodb:// seed list. Set to false to disable the retry.
MONGODB_SRV_DOH_FALLBACK=true
# Optional JSON DoH endpoints, comma-separated. Default is Cloudflare then Google.
# MONGODB_SRV_DOH_URL=
# Diagnostics only: skip createIndex calls so a read-only connection check cannot change indexes.
# MONGO_SKIP_INDEX_INIT=false
# GOOGLE_APPLICATION_CREDENTIALS=C:/private/firebase-service-account.json
# ACCOUNT_DATA_DIR=.data/accounts
# Local testing only, never production; project must start with demo-.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

HELIUS_NETWORK=devnet
NFT_MARKETPLACE_PROVIDER=tensor
NFT_ASSET_PROVIDER=helius
DEMO_MODE=true

# Na Vault: the Devnet mandate program that pays for genuine NFT purchases. The backend loads
# backend/.env, so these must be present here as well as in the root example. See
# docs/GENUINE_NFT_PURCHASE.md.
NA_PROGRAM_ID=CHjdqooB7TrussJoZoboFP5TtdCspoHtvPpqoshbr5zE
# Server-only agent keypair: 64-byte JSON array or base58. Fee payer and authorized executor only.
# Never an owner key or seed phrase. Keep outside source control.
NA_AGENT_KEYPAIR=
# Optional pinned Devnet settlement recipient public key, used only by the legacy DEMO spend.
NA_SETTLEMENT_ADDRESS=
